{
  "name": "focus-tasks",
  "version": "0.2.2",
  "private": true,
  "description": "Focus Tasks — an Obsidian plugin",
  "scripts": {
    "test": "node test/e2e.mjs",
    "test:tasks": "node test/e2e.mjs --with-tasks",
    "test:tasknotes": "node test/e2e.mjs --with-tasknotes",
    "test:model": "node test/model.mjs",
    "test:audit": "node --test test/audit.mjs test/archive-repair.mjs test/delivery.mjs test/vault-audit.mjs",
    "test:stress": "node --test test/stress.mjs",
    "test:mobile": "node test/mobile.mjs",
    "zip": "rm -rf dist && mkdir -p dist/focus-tasks && cp main.js manifest.json styles.css README.md dist/focus-tasks/ && cd dist && zip -qr focus-tasks-$npm_package_version.zip focus-tasks",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "ws": "^8.18.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zast4/focus-tasks"
  },
  "dependencies": {
    "moment": "^2.31.0"
  }
}
